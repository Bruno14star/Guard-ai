{
  "entities": {
    "User": {
      "title": "User",
      "description": "Private user account and safety metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "username": { "type": "string", "minLength": 1, "maxLength": 64 },
        "phone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 160 },
        "city": { "type": "string", "maxLength": 100 },
        "userState": { "type": "string", "maxLength": 64 },
        "bio": { "type": "string", "maxLength": 300 },
        "photoURL": { "type": "string", "maxLength": 150000 },
        "profilePicUrl": { "type": "string", "maxLength": 150000 },
        "emergencyContact": { "type": "string", "maxLength": 160 },
        "role": { "type": "string", "enum": ["user", "admin", "banned"] },
        "safetyScore": { "type": "number" },
        "trust_score": { "type": "number" },
        "streak": { "type": "number" },
        "subscription": { "type": "string", "enum": ["free", "active", "pending", "expired"] },
        "verifiedBadge": { "type": "boolean" },
        "tutorialSeen": { "type": "boolean" },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "walletBalance": { "type": "number" },
        "lastStreakDate": { "type": "string", "maxLength": 20 },
        "lastActive": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "role", "createdAt"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Public non-PII user profile for leaderboards and community profile cards",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "username": { "type": "string", "maxLength": 64 },
        "bio": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 100 },
        "userState": { "type": "string", "maxLength": 64 },
        "photoURL": { "type": "string", "maxLength": 150000 },
        "verifiedBadge": { "type": "boolean" },
        "trust_score": { "type": "number" },
        "safetyScore": { "type": "number" },
        "streak": { "type": "number" },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "totalReports": { "type": "number" },
        "verifiedReports": { "type": "number" },
        "totalScans": { "type": "number" },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "fullName"]
    },
    "FamilyMember": {
      "title": "FamilyMember",
      "description": "Tracked family circle member",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "memberPhone": { "type": "string", "minLength": 5, "maxLength": 32 },
        "relationship": { "type": "string", "minLength": 1, "maxLength": 48 },
        "photoURL": { "type": "string", "maxLength": 150000 },
        "lastLat": { "type": "number" },
        "lastLng": { "type": "number" },
        "lastAddress": { "type": "string", "maxLength": 250 },
        "isOnline": { "type": "boolean" },
        "status": { "type": "string", "enum": ["Safe", "SOS"] },
        "lastSeen": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "memberName", "memberPhone", "relationship", "status"]
    },
    "ScannerLog": {
      "title": "ScannerLog",
      "description": "Road, vehicle, or building scan telemetry record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "buildingLat": { "type": "number" },
        "buildingLng": { "type": "number" },
        "address": { "type": "string", "maxLength": 250 },
        "vehicleType": { "type": "string", "maxLength": 32 },
        "floorsDetected": { "type": "number" },
        "sensorValue": { "type": "number" },
        "frequency": { "type": "number" },
        "confidence": { "type": "number" },
        "safeScore": { "type": "number" },
        "status": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "status", "createdAt"]
    },
    "AlertItem": {
      "title": "AlertItem",
      "description": "Verified Guard AI security alert",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 120 },
        "type": { "type": "string", "maxLength": 40 },
        "title": { "type": "string", "maxLength": 160 },
        "description": { "type": "string", "maxLength": 1000 },
        "address": { "type": "string", "maxLength": 250 },
        "incidentState": { "type": "string", "maxLength": 64 },
        "incidentArea": { "type": "string", "maxLength": 120 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "confidence": { "type": "number" },
        "status": { "type": "string", "enum": ["New", "Seen", "Resolved"] },
        "videoUrl": { "type": "string", "maxLength": 2000 },
        "photoUrl": { "type": "string", "maxLength": 2000 },
        "verifiedByGuardAI": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "address", "status", "verifiedByGuardAI", "createdAt"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "User subscription plan record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "plan": { "type": "string", "enum": ["Free", "Monthly", "Yearly"] },
        "status": { "type": "string", "enum": ["active", "pending", "expired", "rejected"] },
        "amount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "plan", "status", "amount", "createdAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Manual OPay transfer receipt awaiting admin review",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userName": { "type": "string", "maxLength": 120 },
        "plan": { "type": "string", "enum": ["Monthly", "Yearly"] },
        "amount": { "type": "number" },
        "purpose": { "type": "string", "maxLength": 120 },
        "receiptImage": { "type": "string", "maxLength": 500000 },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "plan", "amount", "receiptImage", "status", "createdAt"]
    },
    "IncidentReport": {
      "title": "IncidentReport",
      "description": "User incident report submitted for Guard AI + Admin verification",
      "type": "object",
      "properties": {
        "reportId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userName": { "type": "string", "maxLength": 120 },
        "userPhone": { "type": "string", "maxLength": 32 },
        "userState": { "type": "string", "maxLength": 64 },
        "incidentState": { "type": "string", "maxLength": 64 },
        "incidentArea": { "type": "string", "maxLength": 120 },
        "incidentAddress": { "type": "string", "maxLength": 250 },
        "incidentType": { "type": "string", "maxLength": 40 },
        "description": { "type": "string", "maxLength": 1500 },
        "videoUrl": { "type": "string", "maxLength": 500000 },
        "videoDurationSec": { "type": "number" },
        "photoUrl": { "type": "string", "maxLength": 500000 },
        "gpsLat": { "type": "number" },
        "gpsLng": { "type": "number" },
        "videoAuthScore": { "type": "number" },
        "audioMatchScore": { "type": "number" },
        "locationConsistencyScore": { "type": "number" },
        "crossReportScore": { "type": "number" },
        "guardAiScore": { "type": "number" },
        "aiVerdict": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "maxLength": 64 },
        "adminDecision": { "type": "string", "maxLength": 32 },
        "adminReason": { "type": "string", "maxLength": 300 },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "paid"] },
        "forwardedTo": { "type": "string", "maxLength": 32 },
        "forwardedState": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "incidentType", "incidentAddress", "status", "createdAt"]
    },
    "PoliceStation": {
      "title": "PoliceStation",
      "description": "Admin-only state police contact record",
      "type": "object",
      "properties": {
        "state": { "type": "string", "maxLength": 64 },
        "area": { "type": "string", "maxLength": 120 },
        "stationName": { "type": "string", "maxLength": 160 },
        "phone1": { "type": "string", "maxLength": 32 },
        "phone2": { "type": "string", "maxLength": 32 },
        "isVerified": { "type": "boolean" },
        "isActive": { "type": "boolean" }
      },
      "required": ["state", "stationName", "phone1", "isVerified", "isActive"]
    },
    "SafeBusiness": {
      "title": "SafeBusiness",
      "description": "Verified safe haven business location",
      "type": "object",
      "properties": {
        "businessName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "type": { "type": "string", "enum": ["Church", "School", "Mall", "Hospital", "Office", "Market"] },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "address": { "type": "string", "maxLength": 250 },
        "rating": { "type": "number" },
        "verified": { "type": "boolean" },
        "safeScore": { "type": "number" },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessName", "type", "address", "verified", "ownerId", "createdAt"]
    },
    "HomeVideo": {
      "title": "HomeVideo",
      "description": "Verified and paid ₦5,000 incident video featured on Home",
      "type": "object",
      "properties": {
        "reportId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 120 },
        "userProfilePic": { "type": "string", "maxLength": 150000 },
        "videoUrl": { "type": "string", "maxLength": 500000 },
        "incidentType": { "type": "string", "maxLength": 40 },
        "incidentState": { "type": "string", "maxLength": 64 },
        "incidentArea": { "type": "string", "maxLength": 120 },
        "incidentAddress": { "type": "string", "maxLength": 250 },
        "views": { "type": "number" },
        "likes": { "type": "number" },
        "verifiedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reportId", "userId", "userName", "videoUrl", "incidentType", "verifiedAt"]
    },
    "UserUsageStats": {
      "title": "UserUsageStats",
      "description": "Real monthly usage stats powering the Top 10 leaderboard",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "avatar": { "type": "string", "maxLength": 150000 },
        "totalScans": { "type": "number" },
        "totalReports": { "type": "number" },
        "verifiedReports": { "type": "number" },
        "totalUsageDays": { "type": "number" },
        "lastActiveDate": { "type": "string", "maxLength": 20 },
        "totalUsageMinutes": { "type": "number" },
        "totalPoints": { "type": "number" },
        "month": { "type": "string", "maxLength": 10 },
        "cheatingFlagged": { "type": "boolean" },
        "lastActive": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "totalScans", "verifiedReports", "totalPoints", "month"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/User" }, "description": "Private user account records" },
    "/public_profiles/{userId}": { "schema": { "$ref": "#/entities/PublicProfile" }, "description": "Public non-PII user profiles" },
    "/me_profiles/{userId}": { "schema": { "$ref": "#/entities/User" }, "description": "Me tab editable profiles" },
    "/family_tracking/{memberId}": { "schema": { "$ref": "#/entities/FamilyMember" }, "description": "Live family GPS tracking docs" },
    "/road_scanner/{scanId}": { "schema": { "$ref": "#/entities/ScannerLog" }, "description": "Live road scans" },
    "/vehicle_scanner/{scanId}": { "schema": { "$ref": "#/entities/ScannerLog" }, "description": "Live vehicle scans" },
    "/building_scanner/{scanId}": { "schema": { "$ref": "#/entities/ScannerLog" }, "description": "Live building scans" },
    "/night_watch_alerts/{alertId}": { "schema": { "$ref": "#/entities/ScannerLog" }, "description": "Night Watch 100m threat alarms" },
    "/alerts/{alertId}": { "schema": { "$ref": "#/entities/AlertItem" }, "description": "Verified security alerts" },
    "/subscriptions/{subId}": { "schema": { "$ref": "#/entities/Subscription" }, "description": "Subscription plans" },
    "/payments/{paymentId}": { "schema": { "$ref": "#/entities/Payment" }, "description": "Manual OPay receipt uploads" },
    "/incident_reports/{reportId}": { "schema": { "$ref": "#/entities/IncidentReport" }, "description": "Incident reports awaiting verification" },
    "/police_stations/{stationId}": { "schema": { "$ref": "#/entities/PoliceStation" }, "description": "Admin-only 37-state police contacts" },
    "/safe_business/{businessId}": { "schema": { "$ref": "#/entities/SafeBusiness" }, "description": "Verified safe haven businesses" },
    "/home_videos/{videoId}": { "schema": { "$ref": "#/entities/HomeVideo" }, "description": "Verified and paid ₦5,000 videos on Home" },
    "/user_usage_stats/{statId}": { "schema": { "$ref": "#/entities/UserUsageStats" }, "description": "Real monthly usage stats for Top 10" },
    "/guard_users_live/{userId}": { "schema": "GuardLive", "description": "Live user GPS and mic status" },
    "/user_permissions/{userId}": { "schema": "UserPermissions", "description": "Real device permission grants" },
    "/user_sessions/{sessionId}": { "schema": "UserSession", "description": "User session duration logs" },
    "/screen_time/{entryId}": { "schema": "ScreenTime", "description": "Per-screen seconds analytics" },
    "/wallet_transactions/{txId}": { "schema": "WalletTx", "description": "₦5,000 report reward transactions" },
    "/notifications/{notifId}": { "schema": "Notification", "description": "User alerts and weekly good-wish messages" },
    "/sansa_memory/{memoryId}": { "schema": "SansaMemory", "description": "Sansa AI intelligence log and daily tips" },
    "/admin/{logId}": { "schema": "AdminLog", "description": "Admin action audit trail" },
    "/app_settings/{settingId}": { "schema": "AppSettings", "description": "Admin-editable OPay payment details" },
    "/follows/{followId}": { "schema": "Follow", "description": "User follow relationships" },
    "/chats/{msgId}": { "schema": "ChatMessage", "description": "1-to-1 user chat messages" },
    "/report_comments/{commentId}": { "schema": "ReportComment", "description": "Comments on verified home videos" },
    "/admins/{uid}": { "schema": "AdminMarker", "description": "Trusted admin role registry" }
  }
}
