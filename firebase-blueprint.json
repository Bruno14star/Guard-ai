    "/report_audit_logs/{logId}": { "schema": { "$ref": "#/entities/ReportAuditLog" }, "description": "Immutable audit log for submitted reports" },
    "/admins/{uid}": { "schema": "AdminMarker", "description": "Trusted admin role registry" }
  }
}
